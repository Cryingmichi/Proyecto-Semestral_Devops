# Este archivo es una PLANTILLA. No debe llevar la contraseña real
# en texto plano dentro del repositorio (IE5: gestion de secrets).
#
# Para crear el secret real en el cluster, usar el comando imperativo
# (no aplicar este archivo tal cual):
#
#   kubectl create secret generic db-credentials \
#     --namespace=innovatech \
#     --from-literal=MYSQL_ROOT_PASSWORD='TU_PASSWORD_SEGURA' \
#     --from-literal=DB_USERNAME=root \
#     --from-literal=DB_PASSWORD='TU_PASSWORD_SEGURA'
#
# Esto evita que la contraseña quede versionada en Git.

apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: innovatech
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "CAMBIAR_ANTES_DE_APLICAR"
  DB_USERNAME: "root"
  DB_PASSWORD: "CAMBIAR_ANTES_DE_APLICAR"
